<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hdc.claude-agent-loop.repo-audit</string>
    <!-- The job's own stdout/stderr are redirected by the shell, not by
         launchd's StandardOutPath/StandardErrorPath (which are /dev/null
         below). The dispatch log names client packages one per due line, so
         it must NOT land in world-readable /tmp the way the usage-poll job's
         log does — that job logs only anonymous quota numbers, and this is a
         different sensitivity class. launchd performs no variable or tilde
         expansion in its path keys, so the only way to reach a path under
         $HOME from a template that is copied verbatim onto any machine is to
         redirect from inside the shell command. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>LOGS="$HOME/.claude/metrics/audit/logs"; mkdir -p "$LOGS"; exec /usr/bin/env python3 "$HOME/.claude/tools/audit_dispatch.py" --workspace "$HOME/dev" >>"$LOGS/repo-audit.out.log" 2>>"$LOGS/repo-audit.err.log"</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>17</integer>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardOutPath</key>
    <string>/dev/null</string>
    <key>StandardErrorPath</key>
    <string>/dev/null</string>
</dict>
</plist>
