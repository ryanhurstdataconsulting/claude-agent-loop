# secrets.env.template — credentials template
# -----------------------------------------------------------------------------
# COPY this file to `secrets.env` in the project that needs it, then fill in
# the values YOURSELF. Never commit `secrets.env` — it should stay gitignored
# everywhere in your workspace.
#
# Every value below is intentionally EMPTY. There are NO real credentials in
# this starter kit. Fill them in from your own environment (or from whoever
# provisions your accounts) during `environment-bootstrap`. Do not guess
# hostnames or keys.
#
# Format is KEY=value, one per line, no spaces around the "=", no quotes needed.
# -----------------------------------------------------------------------------

# --- Database, over an SSH tunnel (if the database is remote) ----------------
# Your own read-only database username. Used in the postgres-readonly MCP
# connection string, in place of <DB_USER>.
DB_USER=

# The bastion host you SSH through, if the database sits behind one.
BASTION_HOST=

# The database host the tunnel forwards to (or the direct host, if there is
# no bastion).
DB_HOST=

# The database name.
DB_NAME=

# Absolute path to your PERSONAL SSH key for the bastion (chmod 600). Never
# share it.
SSH_KEY_PATH=

# Local port the tunnel listens on. The postgres-readonly MCP spec assumes
# 15432.
LOCAL_TUNNEL_PORT=

# The password for the read-only role above. Referenced as an environment
# variable — never embed it in the MCP registration itself.
PGPASSWORD=

# --- Your REST API (if your workflow includes one) ---------------------------
# One base URL and one bearer token per environment. Tokens are typically
# personal and short-lived; refresh them per your API's own auth flow. Leave
# blank until you provision your own account.

# DEV
API_DEV_BASE_URL=
API_DEV_ACCESS_TOKEN=
API_DEV_REFRESH_TOKEN=

# QA
API_QA_BASE_URL=
API_QA_ACCESS_TOKEN=
API_QA_REFRESH_TOKEN=

# PROD
API_PROD_BASE_URL=
API_PROD_ACCESS_TOKEN=
API_PROD_REFRESH_TOKEN=

# --- Anthropic API key (optional; used by the prompt-clarity-gate hook) ------
# The prompt-clarity-gate UserPromptSubmit hook makes one small Claude Haiku
# call to restructure long/noisy prompts and to ask a clarifying question when
# a request is genuinely ambiguous. It is billed to your own account, and it
# only fires on prompts that clear a length/noise bar (or that you prefix with
# "clean:"), so the common case costs nothing.
#
# Leave this EMPTY and the hook fails open — it stays completely silent and
# never blocks a prompt. Nothing else in the framework requires this key.
#
# Get one at https://console.anthropic.com/ -> API Keys. Note that a valid key
# on an account with no credit balance returns HTTP 400, which the hook also
# treats as a reason to stay silent.
ANTHROPIC_API_KEY=
